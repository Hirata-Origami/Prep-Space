# ============================================================
# PrepSpace Platform — Environment Variables
# Copy this to apps/web/.env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Gemini AI ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
NEXT_PUBLIC_HAS_GLOBAL_KEY=true

# ── Upstash Redis (Caching & Rate Limiting) ───────────────────
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Maileroo SMTP (Email Notifications) ───────────────────────
SMTP_HOST=smtp.maileroo.com
SMTP_PORT=587
SMTP_USER=your-maileroo-user
SMTP_PASSWORD=your-maileroo-password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME="PrepSpace"

# ── App URL ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ── GitHub (optional) ─────────────────────────────────────────
# A read-only token with NO scopes lifts the shared 60 requests/hour limit for public repo lookups.
# Users never enter a token. Create one at github.com/settings/tokens.
GITHUB_TOKEN=

# ── Cron (optional) ───────────────────────────────────────────
# If set, /api/cron/* require it as a bearer token. If empty they still run, once per period.
CRON_SECRET=
